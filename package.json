    "@types/pg": "^8.23.1",
    "@vitejs/plugin-react": "^6.1.1",
    "adm-zip": "^0.5.16",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "fast-xml-parser": "^4.5.1",
    "lucide-react": "^0.546.0",
    "mammoth": "^1.9.0",
    "motion": "^12.23.24",
    "pdfjs-dist": "^4.10.38",
    "pg": "^8.23.1",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "tar": "^7.4.3",
    "tsx": "^4.21.0",
