{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "tsx server.ts",
    "start": "npm run build:server && node server-build/server.js --production",
    "build": "npm run build:web && npm run build:server",
    "build:web": "vite build && node scripts/sync_vercel_static.mjs",
    "build:server": "node scripts/build_server.mjs",
    "preview": "vite preview",
    "migrate": "tsx scripts/migrate_database.ts",
    "clean": "rm -rf dist server-build",
    "lint": "tsc --noEmit",
    "test": "tsx tests/run_all_tests.ts",
    "start:built": "node server-build/server.js --production"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
