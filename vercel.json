{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "express",
  "installCommand": "npm install --ignore-scripts --no-audit --no-fund",
  "buildCommand": "npm run build",
  "functions": {
    "server.ts": {
      "maxDuration": 60,
      "includeFiles": "{public/**,node_modules/pdfjs-dist/**,node_modules/@ffmpeg-installer/**,node_modules/@ffprobe-installer/**}"
    }
  }
}
