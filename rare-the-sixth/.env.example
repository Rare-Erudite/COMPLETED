# Optional server-side provider credentials. Never expose these to Vite or the APK.
# Genuine AI is OPTIONAL and free by default: with no key at all, RARE uses its
# local Ollama daemon when present and its built-in offline cognitive engine otherwise.
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Optional bridge to the companion RARE-INTELLIGENCE engine for genuine AI answers.
# User-supplied-key providers (OpenAI-compatible, Gemini-free-tier) are configured
# inside the engine repo; SIXTH reaches them through this bridge. Leave blank to
# disable (default). The engine keeps all provider keys server-side.
RARE_INTELLIGENCE_URL=
RARE_INTELLIGENCE_API_KEY=
RARE_INTELLIGENCE_TIMEOUT_MS=

# Optional server-side application settings.
RARE_API_TOKEN=
# Required to enable Developer Space. Without this, developer login is disabled.
RARE_DEV_KEY=

# Optional public backend URL for a separately hosted client or Android APK build.
# For a same-origin web deployment, leave blank: the app uses the current origin.
VITE_BACKEND_URL=
