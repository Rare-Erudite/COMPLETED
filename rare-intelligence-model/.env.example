# Google Gemini API key for external model inference (optional, free tier)
GEMINI_API_KEY=

# OpenAI-compatible endpoint (optional). Works with a user-supplied hosted key
# (OpenAI, Groq, OpenRouter, Together, ...) OR a FREE local server
# (llama.cpp --server, LM Studio, vLLM, LocalAI) — no mandatory paid service.
OPENAI_API_KEY=
OPENAI_BASE_URL=http://127.0.0.1:8080/v1
OPENAI_MODEL=gpt-4o-mini

# Local Ollama host endpoint (optional)
OLLAMA_HOST=http://127.0.0.1:11434

# Security API keys (optional; default dev/client keys provided in auth manager)
RARE_API_KEY=
RARE_DEV_KEY=

# Server port (default 3000)
PORT=3000
