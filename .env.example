# ==============================================================================
# RARE CORE INTELLIGENCE — ENVIRONMENT CONFIGURATION
# ==============================================================================

# Database & Storage
DATABASE_URL=

# Core LLM & Coprocessor Providers
GEMINI_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=
ANTHROPIC_API_KEY=
OLLAMA_HOST=

# Google Cloud Text-to-Speech (Server-Side High-Fidelity Neural Speech Synthesis)
GOOGLE_TTS_API_KEY=

# Developer Space Gating Key (Server-Side Passkey)
RARE_DEV_KEY=

# RARE Intelligence Engine Gateway & Authentication
RARE_API_KEY=
RARE_API_TOKEN=
RARE_INTELLIGENCE_API_KEY=
RARE_INTELLIGENCE_TIMEOUT_MS=
RARE_INTELLIGENCE_URL=

# Email Delivery Provider (SendGrid / Resend transactional delivery)
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM=no-reply@rare-erudite.com

# SMS Delivery Provider (Twilio standard SMS dispatch)
SMS_PROVIDER_ACCOUNT_ID=
SMS_PROVIDER_AUTH_TOKEN=
SMS_PROVIDER_FROM=

# WhatsApp Messaging Provider (Twilio WhatsApp business dispatch)
WHATSAPP_PROVIDER_ACCOUNT_ID=
WHATSAPP_PROVIDER_AUTH_TOKEN=
WHATSAPP_PROVIDER_FROM=

# OAuth 2.0 / OpenID Connect Identity Verification
GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=
MICROSOFT_CLIENT_ID=
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=
VITE_MICROSOFT_CLIENT_ID=
VITE_MICROSOFT_TENANT_ID=
VITE_MICROSOFT_REDIRECT_URI=

# Required in production: exact comma-separated browser origins for the configured frontend.
RARE_ALLOWED_ORIGINS=

# Application owner. Developer-access requests are dispatched to this address and
# it is the account treated as owner in Developer Space. Defaults to the
# documented owner account when unset; set it explicitly in production so the
# address shown in the UI matches the account that really holds the role.
RARE_OWNER_EMAIL=
# Optional: pin the owner by account id as well as by email.
RARE_OWNER_ACCOUNT_ID=

# Web Client Backend URL (Optional Override)
VITE_BACKEND_URL=
