# RARE Environment Configuration Example

# Server Listening Port (defaults to 3000 if omitted)
PORT=3000

# Developer Authorization Passkey (required for /api/developer/* routes)
# When omitted or empty, developer authorization routes will safely return HTTP 503.
RARE_DEV_KEY=your_secure_developer_passkey_here

# PostgreSQL / Supabase Connection URL for persistent database storage
# Fallbacks to local file storage (.rare/state/persistent-documents.json) if unconfigured.
DATABASE_URL=postgresql://postgres:password@localhost:5432/rare_db

# Google Gemini API Key for speech transcription and multimodal capabilities
GEMINI_API_KEY=your_gemini_api_key_here

# Google OAuth Client ID for verified Google OAuth token verification
GOOGLE_CLIENT_ID=your_google_oauth_client_id_here

# Microsoft Outlook OAuth Client ID and Tenant ID for Microsoft OAuth verification
MICROSOFT_CLIENT_ID=your_microsoft_client_id_here
MICROSOFT_TENANT_ID=common

# Google Cloud Text-to-Speech API Key
GOOGLE_TTS_API_KEY=your_google_tts_api_key_here

# RARE Companion API Key
RARE_API_KEY=your_rare_api_key_here

# Local Ollama Host URL (optional)
OLLAMA_HOST=http://127.0.0.1:11434

# OpenAI API Key (optional AI model provider)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o

# Anthropic API Key (optional AI model provider)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Twilio Credentials (SMS verification provider)
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=your_twilio_phone_number_here

# SendGrid API Key (Email verification provider)
SENDGRID_API_KEY=your_sendgrid_api_key_here
SENDGRID_FROM_EMAIL=noreply@example.com

# Node Environment ('development' or 'production')
NODE_ENV=development
